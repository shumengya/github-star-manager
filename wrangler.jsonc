{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-star-manager",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/github/*"]
  },
  "build": {
    "command": "pnpm build"
  }
}
